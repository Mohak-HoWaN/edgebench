# Copy to .env to change a setting. Every EDGEBENCH_ variable overrides the default in server/edgebench/config.py.
# Never put secrets in a file that is committed; .env itself is git-ignored.

# Where the database, models and results live.
EDGEBENCH_DATA_DIR=data

# Local only by default. Do not change until device tokens exist (Phase 5).
EDGEBENCH_HOST=127.0.0.1
EDGEBENCH_PORT=8000

# Folder holding the built web app (web/dist). Unset in development, where Vite serves the pages.
# EDGEBENCH_WEB_DIST=web/dist

# Host names the server answers to (JSON list).
# EDGEBENCH_ALLOWED_HOSTS=["localhost","127.0.0.1"]

EDGEBENCH_LOG_LEVEL=INFO
